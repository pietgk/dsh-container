{
  "name": "dsh-container",
  "version": "0.1.0",
  "private": true,
  "description": "A narrow Apple Container manager for isolated DSH evaluation instances",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pietgk/dsh-container.git"
  },
  "homepage": "https://github.com/pietgk/dsh-container#readme",
  "bugs": {
    "url": "https://github.com/pietgk/dsh-container/issues"
  },
  "type": "module",
  "bin": {
    "dsh-container": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:live": "DSH_E2E_LIVE_MODEL=1 playwright test e2e/live-model.spec.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
